{
  "name": "sidechannel",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "INVITES", "class_name": "Invite" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Invite"] }],
  // No request logs: nothing about who used the site is kept.
  "observability": { "enabled": false }
}
